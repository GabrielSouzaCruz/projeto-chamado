# =============================================================================
# .env.example — Central de Chamados
# Copie este arquivo para .env e preencha com os valores reais:
#     cp .env.example .env     (Linux/Mac)
#     copy .env.example .env   (Windows)
#
# ⚠️ NUNCA commite o .env real (ele está no .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# DJANGO (obrigatório)
# ---------------------------------------------------------------------------
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True em desenvolvimento / False em produção
DEBUG=True

# ---------------------------------------------------------------------------
# BANCO DE DADOS
# ---------------------------------------------------------------------------
# Vazio usa SQLite local (settings.py). Em produção use o Postgres do Render:
# DATABASE_URL=postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=

# ---------------------------------------------------------------------------
# SENTRY (observabilidade) — opcional
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# CLOUDINARY — STORAGE DE MÍDIA NA NUVEM (anexos duram entre deploys)
# Caminho RECOMENDADO: as 3 chaves nomeadas abaixo (dashboards.cloudinary.com
# -> Settings -> API Keys). Com elas, o storage default vira o Cloudinary.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legado (opcional): alternativa em uma única URL — cloudinary://api_key:api_secret@cloud_name
# Só é usada se as 3 chaves nomeadas acima NÃO estiverem definidas.
CLOUDINARY_URL=

# ---------------------------------------------------------------------------
# PUSHER — TEMPO REAL (obrigatório se quiser notificações ao vivo)
# dashboards.pusher.com -> App Keys
# ---------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ---------------------------------------------------------------------------
# CYPRESS / E2E (apenas testes) — usuários criados por `python manage.py seed_e2e`
# ---------------------------------------------------------------------------
E2E_TECNICO_USER=qa_tecnico
E2E_TECNICO_PASS=qa-senha-123
E2E_SOLICITANTE_USER=qa_solicitante
E2E_SOLICITANTE_PASS=qa-senha-123
